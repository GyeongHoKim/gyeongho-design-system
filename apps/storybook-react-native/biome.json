{
  "root": false,
  "extends": "//",
  "linter": {
    "rules": {
      "correctness": {
        "noReactNativeRawText": {
          "level": "error",
          "options": {
            "skip": [
              "Alert",
              "Badge",
              "Bubble",
              "Collapsible",
              "InputGroupAddon",
              "ItemDescription",
              "ItemTitle",
              "Kbd",
              "Label",
              "Marker",
              "MessageAuthor",
              "MessageTimestamp"
            ]
          }
        }
      }
    }
  }
}
