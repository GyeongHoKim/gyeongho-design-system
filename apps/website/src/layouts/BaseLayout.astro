---
import '@ghds/tokens/css';
// Self-hosted web fonts (Fontsource). The font-family stacks in @ghds/tokens
// reference these faces by name; importing the CSS injects the @font-face rules
// and bundles the woff2 files. Latin faces (Gochi Hand, Nunito Sans Variable)
// render Latin glyphs; Korean faces (Gaegu, Noto Sans KR Variable) render Korean glyphs
// via per-glyph fallback — no locale switching needed.
//   sketch/display: Gochi Hand (Latin) + Gaegu (Korean)
//   body/UI:        Nunito Sans Variable (Latin) + Noto Sans KR Variable (Korean)
import '@fontsource/gochi-hand/400.css';
import '@fontsource/gaegu/400.css';
import '@fontsource-variable/nunito-sans/wght.css';
import '@fontsource-variable/noto-sans-kr/wght.css';
// Pretendard (Latin only via fontsource — no Korean subset available).
// Korean body text falls through to Noto Sans KR Variable (above).
import '@fontsource/pretendard/400.css';
import '@fontsource/pretendard/500.css';
import '@fontsource/pretendard/700.css';
import '../styles/global.css';
import type { GhNavMenuItem } from '@ghds/web-components/nav-menu';
import type { Locale } from '../i18n/ui';
import { UI } from '../i18n/ui';
import { NAV_CATEGORIES } from '../lib/nav';
import { setLocale, withBase } from '../lib/withBase';

interface Props {
  /** Document <title>; the site name is appended. */
  title: string;
  /** Meta description for the page. */
  description?: string;
}

const { title, description } = Astro.props;

// Detect the active locale from the URL. Astro's i18n routing puts the locale
// as the first path segment after the base (/en/… or /ko/…).
const locale: Locale = (Astro.currentLocale as Locale) ?? 'en';
setLocale(locale);

const ui = UI[locale];

const normalize = (path: string): string => path.replace(/\/+$/, '') || '/';
// The current path (base + locale aware). Each <gh-nav-menu> marks its matching
// link from this; `withBase` produces matching base-aware hrefs.
const currentPath = normalize(Astro.url.pathname);

// The header IA as a disclosure-navigation list: a direct category renders a
// plain <a href>; a category with children renders a <gh-nav-menu> whose panel
// holds real <a href> links (no menu roles). Groups are keyed by index so the
// inline script below can hand each element its `items` array.
const navLabel = locale === 'ko' ? '주요 내비게이션' : 'Main navigation';
const navEntries = NAV_CATEGORIES.map((category, index) => {
  const href = category.href ? withBase(category.href) : undefined;
  return {
    key: String(index),
    label: category.label[locale],
    href,
    current: href !== undefined && normalize(href) === currentPath,
  };
});
const navGroups: Record<string, GhNavMenuItem[]> = Object.fromEntries(
  NAV_CATEGORIES.flatMap((category, index) =>
    category.children
      ? [
          [
            String(index),
            category.children.map((child) => ({
              label: child.label[locale],
              href: withBase(child.href),
            })),
          ],
        ]
      : [],
  ),
);

// Language switcher: build the equivalent URL in the other locale.
function switchLocaleHref(target: Locale): string {
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  const currentPath = Astro.url.pathname;
  // Strip base + current locale, then prepend base + target locale.
  const stripped = currentPath
    .replace(`${base}/`, '/')
    .replace(/^\/(en|ko)\//, '/')
    .replace(/^\/(en|ko)$/, '/');
  return `${base}/${target}${stripped}`;
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · GHDS</title>
    {description && <meta name="description" content={description} />}
    {/* Apply the persisted theme before first paint to avoid a flash. */}
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('ghds-theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.dataset.theme = stored;
          }
        } catch (_) {
          /* localStorage unavailable — fall back to prefers-color-scheme */
        }
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={withBase('/')}>
        {ui.brand} <small>{ui.brandSubtitle}</small>
      </a>
      <nav class="site-nav" aria-label={navLabel}>
        <ul class="site-nav-list">
          {
            navEntries.map((entry) => (
              <li>
                {entry.href ? (
                  <a
                    class="site-nav-link"
                    href={entry.href}
                    aria-current={entry.current ? 'page' : undefined}
                  >
                    {entry.label}
                  </a>
                ) : (
                  <gh-nav-menu data-nav-group={entry.key} label={entry.label}></gh-nav-menu>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="header-actions">
        <gh-button
          variant="neutral"
          href={switchLocaleHref(locale === 'en' ? 'ko' : 'en')}
          aria-label={locale === 'en' ? '한국어로 보기' : 'View in English'}
        >
          {locale === 'en' ? '한국어' : 'EN'}
        </gh-button>
        <gh-button id="theme-toggle" variant="neutral" aria-live="polite">
          <span data-theme-icon aria-hidden="true">🌗</span>
          <span data-theme-label>{ui.theme}</span>
        </gh-button>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <p>{ui.footer} <code>@ghds/tokens</code>.</p>
    </footer>

    <script>
      import '@ghds/web-components/button';
      import '@ghds/web-components/nav-menu';
    </script>

    {/* Feed each header dropdown its links as a JS property (arrays can't be set
        via attributes). Lit re-applies instance properties set before the
        element upgrades, so ordering against the registration script above is
        safe. */}
    <script define:vars={{ navGroups, currentPath }}>
      for (const menu of document.querySelectorAll('gh-nav-menu[data-nav-group]')) {
        const items = navGroups[menu.dataset.navGroup];
        if (items) {
          menu.items = items;
          menu.current = currentPath;
        }
      }
    </script>

    <script>
      import { UI } from '../i18n/ui';

      const toggle = document.getElementById('theme-toggle');
      const root = document.documentElement;
      const label = toggle?.querySelector('[data-theme-label]');
      const icon = toggle?.querySelector('[data-theme-icon]');
      const darkQuery = window.matchMedia('(prefers-color-scheme: dark)');

      function effectiveTheme(): 'light' | 'dark' {
        const explicit = root.dataset.theme;
        if (explicit === 'light' || explicit === 'dark') {
          return explicit;
        }
        return darkQuery.matches ? 'dark' : 'light';
      }

      function paint(): void {
        const current = effectiveTheme();
        // Reuse the shared UI dictionary so the chrome labels stay in one place.
        const dict = UI[root.lang === 'ko' ? 'ko' : 'en'];
        if (label) {
          label.textContent = current === 'dark' ? dict.lightMode : dict.darkMode;
        }
        if (icon) {
          icon.textContent = current === 'dark' ? '☀️' : '🌙';
        }
        toggle?.setAttribute(
          'aria-label',
          current === 'dark' ? dict.switchToLight : dict.switchToDark,
        );
      }

      toggle?.addEventListener('click', () => {
        const next = effectiveTheme() === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('ghds-theme', next);
        } catch (_) {
          /* ignore persistence failures */
        }
        paint();
      });

      // When the user has no explicit choice, follow live OS theme changes so the
      // toggle's icon/label/aria never contradict the page (CSS already follows
      // the OS via prefers-color-scheme).
      darkQuery.addEventListener('change', () => {
        if (!root.dataset.theme) {
          paint();
        }
      });

      paint();
    </script>
  </body>
</html>
