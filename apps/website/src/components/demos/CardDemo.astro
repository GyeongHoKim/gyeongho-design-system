---
// Live demo of `<gh-card>`. Uses `elevated` + `label`, not React's `fill` —
// gh-card has no `fill` prop, matching its real API (see components/card.mdx).
---

<div class="demo-stack">
  <gh-card label="Flat">
    <h3 slot="title">Flat</h3>
    <p>Default sketch outline, no elevation.</p>
  </gh-card>
  <gh-card label="Elevated" elevated>
    <p>Drop-shadow sketch outline suggests elevation.</p>
  </gh-card>
  <gh-card label="Sticky" variant="sticky" fastener="tape">
    <p>Sticky note with tape.</p>
  </gh-card>
  <gh-card label="Lined" variant="lined" fastener="pin">
    <p>Ruled paper with a pin.</p>
  </gh-card>
</div>

<script>
  import '@ghds/web-components/card';
</script>
